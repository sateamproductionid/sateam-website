# Copy this file to `.env.local` (which is gitignored) and fill in real values.

# ─── Admin dashboard auth ──────────────────────────────────────────────
# Password to access /admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Random secret used to sign the session cookie.
# Generate with: openssl rand -hex 32   (or any 32+ char random string)
ADMIN_SESSION_SECRET=change-me-to-a-random-32-char-string

# ─── Vercel Web Analytics (optional, for real data on /admin) ──────────
# Get token: https://vercel.com/account/tokens
# Get project id: Project Settings → General → Project ID
# Team id is only needed for team accounts.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
